# Opcional. Si VISION_API_KEY tiene valor, el análisis de comprobantes
# intenta primero un modelo de visión compatible con la API de OpenAI
# (chat completions con imagen) y, si falla o no responde, sigue con OCR local.
# Sin esta variable la app funciona igual: tesseract.js + reglas.
VISION_API_KEY=
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# Sal del hash de IP que usa el límite de uso. El reporte no guarda la IP ni ese hash.
# OBLIGATORIA en producción (también con `npm start`): si falta o queda el ejemplo,
# la app avisa y el hash usa una sal conocida. Poné una frase larga y propia.
# En desarrollo (`npm run dev`) se usa una sal de prueba si no la definís.
RATE_LIMIT_SALT=cambia-esto-en-produccion

# Clave secreta con la que se calcula el hash (HMAC) de cada teléfono reportado:
# la base nunca guarda el número, solo ese hash. OBLIGATORIA en producción
# (también con `npm start`): sin ella las consultas y los reportes fallan con un error claro.
# Generá una con:  openssl rand -hex 32
# No la cambies después de publicar: los reportes guardados dejarían de coincidir.
# En desarrollo (`npm run dev`) se usa una clave de prueba si no la definís.
TELEFONO_PEPPER=cambia-esto-en-produccion

# Opcional. Topes de uso (peticiones por conexión, salvo el tope por número).
# Súbelos si muchas personas comparten la misma red, por ejemplo en una demo.
# LIMITE_REPORTES_POR_HORA=10
# LIMITE_REPORTES_POR_NUMERO_DIA=5
# LIMITE_CONSULTAS_POR_HORA=120
# LIMITE_ANALISIS_POR_HORA=20

# Producción en Vercel. Sin estas dos, el desarrollo usa SQLite en disco
# (data/semaforo.sqlite) y Vercel usa la semilla en memoria.
# La URL puede ser libsql://... (turso db show <db> --url) o https://...
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Opcional. Por defecto los reportes viven en data/semaforo.sqlite
# SQLITE_PATH=
